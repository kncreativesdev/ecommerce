# Tech Pulse monorepo root ignore (defense-in-depth; nested .gitignores remain authoritative)
# Env / secrets (never commit real .env; .env.example stays trackable)
.env
.env.*
!.env.example
# Dependencies / build output
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
# Local runtime media
storage/uploads/
# Logs / temp / debug
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-error.log*
lerna-debug.log*
*.tmp
*.temp
*.bak
*.swp
# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
