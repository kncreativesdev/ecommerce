# Server
PORT=3000
NODE_ENV=development

# Database (MySQL-compatible connection string; never commit real credentials)
DATABASE_URL=mysql://user:password@localhost:3306/tech_pulse

# CORS origin: single origin or comma-separated list.
# Defaults to http://localhost:3000 when unset. No production domain is assumed here.
CORS_ORIGIN=http://localhost:3000

# Global API rate limit (single-instance in-memory limiter)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging (pino level: trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# Authentication (JWT secrets are required in production; never commit real values)
JWT_ACCESS_SECRET=replace_with_secure_random_secret
JWT_REFRESH_SECRET=replace_with_secure_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_SECURE defaults to true in production; set explicitly only if needed
# REFRESH_COOKIE_SECURE=true

# Auth endpoint rate limit (stricter than the global limiter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
