# Server
PORT=3000
NODE_ENV=development

# Database (MySQL-compatible connection string; never commit real credentials)
DATABASE_URL=mysql://user:password@localhost:3306/tech_pulse

# CORS origin: single origin or comma-separated list.
# Defaults to http://localhost:3000 when unset. No production domain is assumed here.
CORS_ORIGIN=http://localhost:3000

# Global API rate limit (single-instance in-memory limiter)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging (pino level: trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# Authentication (JWT secrets are required in production; never commit real values)
JWT_ACCESS_SECRET=replace_with_secure_random_secret
JWT_REFRESH_SECRET=replace_with_secure_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_SECURE defaults to true in production; set explicitly only if needed
# REFRESH_COOKIE_SECURE=true

# Auth endpoint rate limit (stricter than the global limiter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Audit retention cleanup worker interval (Phase 2C-19 in-process
# scheduler; first run one interval after boot). The retention policy
# itself lives in the database (SUPER_ADMIN-configured, default NEVER).
# AUDIT_CLEANUP_INTERVAL_MS=86400000

# Google Sign-In (Google Identity Services OAuth client ID). Empty until
# configured — the storefront hides the Google button and POST
# /auth/google answers 503 AUTH_GOOGLE_NOT_CONFIGURED.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Outbound email (Nodemailer SMTP) for credential OTP delivery. Empty host
# until configured — OTP endpoints answer 503 EMAIL_NOT_CONFIGURED
# (automated tests capture mail in-memory instead of delivering).
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=smtp-username
# MAIL_SMTP_PASS=smtp-password
# MAIL_FROM=Tech Pulse <no-reply@example.com>

# First SUPER_ADMIN provisioning (`npm run bootstrap:super-admin`).
# One-time operator bootstrap — never an HTTP endpoint, never automatic
# on startup. Keep disabled except for the single provisioning run, and
# never commit real credentials (supply them via the deployment
# environment/secret manager in production).
# BOOTSTRAP_SUPER_ADMIN_ENABLED=false
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Required additionally when NODE_ENV=production:
# BOOTSTRAP_SUPER_ADMIN_ALLOW_PRODUCTION=false
