generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  // SHIPPED is a legacy state kept for historical orders placed before
  // the full fulfilment workflow (DATABASE.md §22). New transitions
  // produce DISPATCHED instead; SHIPPED orders remain readable and may
  // move forward via the compatibility path SHIPPED → IN_TRANSIT |
  // DELIVERED. Never create new SHIPPED states.
  SHIPPED
  DISPATCHED
  IN_TRANSIT
  ARRIVED_IN_CITY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  // CANCELLED marks the payment of a cancelled order. Written only by
  // the atomic order-cancellation transaction (never by the standalone
  // payment-status endpoint); terminal — no transitions leave it.
  CANCELLED
}

enum InventoryTransactionType {
  INITIAL_STOCK
  ORDER
  ORDER_CANCELLED
  RESTOCK
  DAMAGED
  ADJUSTMENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER_STATUS
  MARKETING
}

// Customer return-request lifecycle. Only REQUESTED is produced in the
// current scope (customer submission + viewing); the remaining states are
// the controlled vocabulary for a future admin review workflow. No
// transitions exist yet — a request never leaves REQUESTED today.
enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  WRONG_COLOR
  WRONG_SIZE
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum MarketingNotificationType {
  DEAL
  OFFER
  ANNOUNCEMENT
}

// Company lifecycle for the multi-company SaaS foundation (Phase 1).
// ACTIVE: normal operation. SUSPENDED: operation disabled, data
// preserved (enforcement arrives in a later phase).
enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  // Customer identity is company-scoped (Phase 2C-26): the same
  // normalized email may exist as a CUSTOMER in different companies.
  // Uniqueness is enforced per (companyId, email) below — never by
  // this column alone. Staff/platform emails stay globally unique by
  // application invariant (every staff creation path rejects an email
  // already held by any user), so staff login stays deterministic.
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String?  @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  phone        String?  @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  // Credential watermark (Phase 2C-16): set whenever the password
  // changes (forgot-password reset, authenticated change, SUPER_ADMIN
  // credential reset). The refresh flow rejects tokens issued before
  // it — stateless session invalidation without JWT claim changes.
  // Null means the password never changed since account creation.
  passwordChangedAt DateTime? @map("password_changed_at")
  // Tenant association (Phase 1 foundation). Nullable: platform-level
  // identities such as the future SUPER_ADMIN carry no company, and the
  // column is backfilled for existing rows. Email uniqueness stays
  // global until Phase 2 introduces company-scoped uniqueness.
  companyId    String?  @map("company_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company?  @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)
  adminOf   Company?  @relation("CompanyAdmin")
  roles     UserRole[]
  addresses Address[]
  cart      Cart?
  wishlist  Wishlist?
  orders    Order[]
  reviews   Review[]
  notifications Notification[]
  couponUsages CouponUsage[]
  returnRequests ReturnRequest[]
  passwordOtps PasswordOtp[]
  refreshSessions RefreshSession[]

  @@index([isActive])
  @@index([companyId])
  // Global email lookup index (Phase 2C-26): staff-identity and
  // existence checks query by email alone across companies.
  @@index([email])
  // Company-scoped customer identity (Phase 2C-26): one row per
  // (company, normalized email), so the same email can exist in
  // different companies but never twice in one. NULL companyId rows
  // (platform identities, legacy unassigned accounts) are
  // application-guarded; MySQL treats NULLs as distinct here.
  @@unique([companyId, email])
  @@map("users")
}

// ============================================================
// COMPANIES (multi-company SaaS foundation, Phase 1)
// ============================================================
// One Company = one ecommerce store/business. The company UUID is the
// internal isolation key; it is never accepted from untrusted clients
// (resolution/enforcement arrive in later phases).
// adminUserId is the exactly-one-ADMIN-per-company association. It is
// nullable only for the create/provision bootstrap window between
// company creation and ADMIN credential generation.

model Company {
  id          String        @id @default(uuid()) @db.Char(36)
  name        String        @db.VarChar(255)
  status      CompanyStatus @default(ACTIVE)
  adminUserId String?       @unique @map("admin_user_id") @db.Char(36)
  // Company-scoped Google sign-in allowlist (Phase 4-4): whether Google
  // ID-token authentication is permitted for this company's domain
  // traffic. True by default so rollout changes nothing; SUPER_ADMIN
  // may disable per company. This is NOT the P.6 per-company OAuth
  // client list (mobile audience union) — that remains deferred.
  googleSignInEnabled Boolean @default(true) @map("google_sign_in_enabled")
  // Business profile (SUPER_ADMIN-managed platform metadata, Phase
  // 2C-33). All nullable: existing rows stay NULL (no backfill), and
  // NULL renders as "Not provided" in admin UI. Business-contact data
  // only — never secrets, credentials, or operational ecommerce data.
  // No indexes or unique constraints on these columns. logoPath is a
  // backend-managed storage reference (like Category.image), never
  // client-settable; it is stamped by the dedicated logo upload
  // endpoint only.
  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(30)
  addressLine1 String? @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @map("postal_code") @db.VarChar(20)
  country      String? @db.VarChar(100)
  website      String? @db.VarChar(500)
  logoPath     String? @map("logo_path") @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  admin    User?           @relation("CompanyAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  users    User[]          @relation("CompanyUsers")
  domains  CompanyDomain[]
  categories Category[]
  products   Product[]
  variants   ProductVariant[]
  coupons    Coupon[]
  marketingNotifications MarketingNotification[]
  announcements SiteAnnouncement[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("companies")
}

// ============================================================
// COMPANY DOMAINS (registered-hostname registry, Phase 1)
// ============================================================
// Database registry mapping registered hostnames to companies for
// future domain-based storefront resolution. DNS/TLS automation is
// deployment infrastructure and lives outside the backend. Single
// primary per company is an application-level invariant enforced in a
// later phase (MySQL cannot express it as a partial unique index).

model CompanyDomain {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @map("company_id") @db.Char(36)
  domain    String   @unique @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_domains")
}

// ============================================================
// ROLES
// ============================================================

model Role {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
}

// ============================================================
// USER ROLES
// ============================================================

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================
// PASSWORD OTPS (credential recovery/change, Phase 2C-16)
// ============================================================
// Short-lived single-use verification codes for the forgot-password
// flow (PASSWORD_RESET) and the authenticated password-change flow
// (PASSWORD_CHANGE). Only Argon2id hashes are stored — never the
// code itself. Rows are consumed (usedAt) on success, superseded
// (deleted) when a newer code is issued, and bounded by an attempt
// counter; expiry is enforced by the service on every use.

enum OtpPurpose {
  PASSWORD_RESET
  PASSWORD_CHANGE
}

model PasswordOtp {
  id        String     @id @default(uuid()) @db.Char(36)
  userId    String     @map("user_id") @db.Char(36)
  purpose   OtpPurpose @map("purpose")
  otpHash   String     @map("otp_hash") @db.VarChar(255)
  expiresAt DateTime   @map("expires_at")
  attempts  Int        @default(0) @map("attempts")
  verifiedAt DateTime? @map("verified_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("password_otps")
}

// ============================================================
// REFRESH SESSIONS (one-time refresh-token rotation)
// ============================================================
// Persistent server-side record for every issued refresh token,
// keyed by a SHA-256 hash of the token's `jti` claim (never the
// raw token — a jti alone cannot mint anything without the server
// signing secret). Successful refresh atomically revokes the
// presented row before a successor row is created, so a `jti` is
// consumable exactly once even under concurrent requests; logout
// revokes instead of merely clearing the cookie. Rows survive
// process restarts (MySQL-backed) and cascade with the user.
// Expired rows are purged by bounded cleanup (per-user on
// issuance, global on the retention tick) — never scanned
// unboundedly per request.

model RefreshSession {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  jtiHash   String    @unique @map("jti_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  label        String?  @db.VarChar(50)
  fullName     String   @map("full_name") @db.VarChar(150)
  phone        String   @db.VarChar(30)
  addressLine1 String   @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(20)
  country      String   @db.VarChar(100)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  parentId    String?  @map("parent_id") @db.Char(36)
  name        String   @db.VarChar(150)
  slug        String   @db.VarChar(180)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  // Tenant association (Phase 1 foundation, hardened Phase 2C-10).
  // Slugs are company-local display identifiers (lookups are by id),
  // so uniqueness is per-company. Required: every writer stamps it.
  companyId   String   @map("company_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([companyId])
  @@unique([companyId, slug])
  @@map("categories")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id               String   @id @default(uuid()) @db.Char(36)
  categoryId       String   @map("category_id") @db.Char(36)
  name             String   @db.VarChar(255)
  slug             String   @db.VarChar(280)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.Text
  brand            String?  @db.VarChar(100)
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  // Tenant association (Phase 1 foundation, hardened Phase 2C-10).
  // Slugs are company-local display identifiers (lookups are by id),
  // so uniqueness is per-company. Required: every writer stamps it.
  companyId        String   @map("company_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  couponLinks   CouponProduct[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([categoryId, isActive])
  @@index([companyId])
  @@unique([companyId, slug])
  @@map("products")
}

// ============================================================
// PRODUCT VARIANTS
// ============================================================

model ProductVariant {
  id             String   @id @default(uuid()) @db.Char(36)
  productId      String   @map("product_id") @db.Char(36)
  sku            String   @db.VarChar(100)
  name           String   @db.VarChar(150)
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  // Barcodes live in the manufacturer-global namespace (same physical
  // product across merchants), so barcode uniqueness intentionally
  // stays global. SKUs are merchant-local: unique per company.
  barcode        String?  @unique @db.VarChar(100)
  weight         Decimal? @db.Decimal(10, 3)
  isActive       Boolean  @default(true) @map("is_active")
  // Denormalized tenant association (Phase 1 foundation, per Phase 0
  // decision P.3; hardened Phase 2C-10). Write-once at creation
  // alongside the parent product's companyId; productId itself is
  // immutable by application behavior, so no synchronization mechanism
  // is required. Required: every writer stamps it.
  companyId      String   @map("company_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@index([companyId])
  @@unique([companyId, sku])
  @@map("product_variants")
}

// ============================================================
// PRODUCT IMAGES
// ============================================================

model ProductImage {
  id          String   @id @default(uuid()) @db.Char(36)
  productId   String   @map("product_id") @db.Char(36)
  variantId   String?  @map("variant_id") @db.Char(36)
  filename    String   @db.VarChar(255)
  storagePath String   @map("storage_path") @db.VarChar(500)
  imageType   String   @map("image_type") @db.VarChar(50)
  altText     String?  @map("alt_text") @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id               String   @id @default(uuid()) @db.Char(36)
  variantId        String   @unique @map("variant_id") @db.Char(36)
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  transactions InventoryTransaction[]

  @@map("inventory")
}

// ============================================================
// INVENTORY TRANSACTIONS
// ============================================================

model InventoryTransaction {
  id            String                   @id @default(uuid()) @db.Char(36)
  variantId     String                   @map("variant_id") @db.Char(36)
  quantity      Int
  type          InventoryTransactionType
  referenceType String?                  @map("reference_type") @db.VarChar(50)
  referenceId   String?                  @map("reference_id") @db.Char(36)
  note          String?                  @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [variantId], references: [variantId], onDelete: Restrict)

  @@index([variantId])
  @@index([referenceId])
  @@index([variantId, createdAt])
  @@map("inventory_transactions")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// ============================================================
// CART ITEMS
// ============================================================

model CartItem {
  id        String   @id @default(uuid()) @db.Char(36)
  cartId    String   @map("cart_id") @db.Char(36)
  variantId String   @map("variant_id") @db.Char(36)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

// ============================================================
// WISHLIST ITEMS
// ============================================================

model WishlistItem {
  id         String   @id @default(uuid()) @db.Char(36)
  wishlistId String   @map("wishlist_id") @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id            String      @id @default(uuid()) @db.Char(36)
  userId        String      @map("user_id") @db.Char(36)
  orderNumber   String      @unique @map("order_number") @db.VarChar(30)
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(10, 2)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(10, 2)
  // Coupon applied at checkout (nullable: orders without a coupon, and
  // legacy orders placed before the link existed). The discount itself is
  // snapshotted in `discountTotal`; the relation preserves WHICH coupon
  // (code/definition) produced it. SetNull keeps order history intact if
  // a coupon row is ever removed.
  couponId      String?     @map("coupon_id") @db.Char(36)
  shippingTotal Decimal     @default(0) @map("shipping_total") @db.Decimal(10, 2)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(10, 2)
  grandTotal    Decimal     @db.Decimal(10, 2)
  currency      String      @default("INR") @db.VarChar(3)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon    Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  addresses OrderAddress[]
  payments  Payment[]
  statusHistory OrderStatusHistory[]
  notifications Notification[]
  couponUsage CouponUsage?
  returnRequest ReturnRequest?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([couponId])
  @@map("orders")
}

// ============================================================
// ORDER ITEMS
// ============================================================

model OrderItem {
  id          String   @id @default(uuid()) @db.Char(36)
  orderId     String   @map("order_id") @db.Char(36)
  productId   String   @map("product_id") @db.Char(36)
  variantId   String   @map("variant_id") @db.Char(36)
  productName String   @map("product_name") @db.VarChar(255)
  variantName String?  @map("variant_name") @db.VarChar(150)
  sku         String   @db.VarChar(100)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)
  // Immutable snapshot of the purchased variant's display image at order
  // time (variant primary → variant first → product primary → product
  // first, else null). Historical orders never re-resolve live media.
  imageStoragePath String? @map("image_storage_path") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  review Review?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// ============================================================
// ORDER ADDRESSES
// ============================================================

model OrderAddress {
  id           String           @id @default(uuid()) @db.Char(36)
  orderId      String           @map("order_id") @db.Char(36)
  type         OrderAddressType
  fullName     String           @map("full_name") @db.VarChar(150)
  phone        String           @db.VarChar(30)
  addressLine1 String           @map("address_line1") @db.VarChar(255)
  addressLine2 String?          @map("address_line2") @db.VarChar(255)
  city         String           @db.VarChar(100)
  state        String           @db.VarChar(100)
  postalCode   String           @map("postal_code") @db.VarChar(20)
  country      String           @db.VarChar(100)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([orderId])
  @@map("order_addresses")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                   String        @id @default(uuid()) @db.Char(36)
  orderId              String        @map("order_id") @db.Char(36)
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("INR") @db.VarChar(3)
  transactionReference String?       @map("transaction_reference") @db.VarChar(255)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([transactionReference])
  @@map("payments")
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  productId   String   @map("product_id") @db.Char(36)
  orderItemId String   @unique @map("order_item_id") @db.Char(36)
  rating      Int
  title       String?  @db.VarChar(255)
  comment     String?  @db.Text
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([productId, isApproved])
  @@map("reviews")
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id                    String       @id @default(uuid()) @db.Char(36)
  code                  String       @unique @db.VarChar(50)
  description           String?      @db.Text
  discountType          DiscountType @map("discount_type")
  discountValue         Decimal      @map("discount_value") @db.Decimal(10, 2)
  minimumOrderAmount    Decimal?     @map("minimum_order_amount") @db.Decimal(10, 2)
  maximumDiscountAmount Decimal?     @map("maximum_discount_amount") @db.Decimal(10, 2)
  usageLimit            Int?         @map("usage_limit")
  usedCount             Int          @default(0) @map("used_count")
  startsAt              DateTime?    @map("starts_at")
  expiresAt             DateTime?    @map("expires_at")
  isActive              Boolean      @default(true) @map("is_active")
  // Tenant association (Phase 2C-6, hardened Phase 2C-10). Coupon
  // codes stay globally unique, but every coupon row belongs to
  // exactly one company. Required: stamped at creation.
  companyId             String      @map("company_id") @db.Char(36)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products CouponProduct[]
  orders   Order[]
  usages   CouponUsage[]

  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([companyId])
  @@map("coupons")
}

// ============================================================
// COUPON PRODUCTS
// ============================================================

model CouponProduct {
  couponId  String @map("coupon_id") @db.Char(36)
  productId String @map("product_id") @db.Char(36)

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

// ============================================================
// COUPON USAGES (one-time-per-customer ledger)
// ============================================================
// One row per customer + coupon pair, written atomically inside the
// successful order transaction (never on quote, never on failed orders).
// The @@unique([couponId, userId]) pair is the race guard: concurrent
// same-customer orders using the same coupon serialize on it and all but
// one fail deterministically with COUPON_ALREADY_USED. `orderId` ties the
// usage to the successful order that consumed it. Cancelled orders keep
// their row (no restoration semantics exist by design).

model CouponUsage {
  id String @id @default(uuid()) @db.Char(36)
  couponId String @map("coupon_id") @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  orderId String @unique @map("order_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_usages")
}

// ============================================================
// COUPON HISTORY (admin lifecycle audit)
// ============================================================
// Append-only audit of administrative coupon lifecycle events
// (CREATED / UPDATED / DEACTIVATED / REACTIVATED / DELETED), written in
// the SAME transaction as the coupon mutation. Deliberately FK-free
// (same convention as OrderStatusHistory.createdBy): history must survive
// coupon deletion and admin deactivation. `actorEmail` is a display
// snapshot taken at event time. Customer coupon usage is NOT recorded
// here — CouponUsage remains its source of truth.

enum CouponHistoryAction {
  CREATED
  UPDATED
  DEACTIVATED
  REACTIVATED
  DELETED
}

model CouponHistory {
  id         String               @id @default(uuid()) @db.Char(36)
  couponId   String               @map("coupon_id") @db.Char(36)
  actorId    String?              @map("actor_id") @db.Char(36)
  actorEmail String?              @map("actor_email") @db.VarChar(255)
  action     CouponHistoryAction  @map("action")
  metadata   Json?                @map("metadata")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([couponId, createdAt])
  @@index([actorId])
  @@map("coupon_histories")
}

// ============================================================
// ORDER STATUS HISTORY
// ============================================================
// Immutable per-order lifecycle ledger: one row per genuine state
// change (creation seeds PENDING; every admin transition appends).
// Never updated or deleted by application code; never aggregated for
// revenue/analytics. Legacy orders created before this table exist
// without rows — readers must fall back to the order's current status.

model OrderStatusHistory {
  id             String      @id @default(uuid()) @db.Char(36)
  orderId        String      @map("order_id") @db.Char(36)
  status         OrderStatus
  previousStatus OrderStatus? @map("previous_status")
  // Optional operational note entered by the admin at transition time
  // (e.g. "Handed to courier"). Standard customer-facing messages are
  // generated from the status, never typed per transition.
  note           String?     @db.VarChar(500)
  // Admin user id that performed the transition; null for system events
  // (e.g. the creation seed). No hard FK: admin accounts are never
  // deleted, but history must survive even if one were removed.
  createdBy      String?     @map("created_by") @db.Char(36)
  createdAt      DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ============================================================
// ORDER RETURNS (customer return-request workflow)
// ============================================================
// A return request is a SEPARATE business process from the order
// lifecycle: it never mutates Order.status, OrderStatusHistory, payments,
// or inventory. Order-level granularity (one request per order, enforced
// by @@unique([orderId])); every stored request is permanently active in
// the current scope since no status-change workflow exists yet, which
// also makes the unique constraint the duplicate-creation race guard.

model ReturnRequest {
  id        String              @id @default(uuid()) @db.Char(36)
  orderId   String              @unique @map("order_id") @db.Char(36)
  userId    String              @map("user_id") @db.Char(36)
  status    ReturnRequestStatus @default(REQUESTED)
  reason    ReturnReason
  details   String?             @db.VarChar(1000)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  order   Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  history ReturnRequestHistory[]

  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

model ReturnRequestHistory {
  id              String              @id @default(uuid()) @db.Char(36)
  returnRequestId String              @map("return_request_id") @db.Char(36)
  status          ReturnRequestStatus
  actorId         String?             @map("actor_id") @db.Char(36)
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId, createdAt])
  @@map("return_request_history")
}

// ============================================================
// NOTIFICATIONS (transactional, per-user)
// ============================================================
// System-generated customer notifications (currently order-status
// events). Created transactionally with the triggering state change;
// never faked client-side. Marketing broadcasts live in
// MarketingNotification and are NOT fanned out here.

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  type      NotificationType @default(ORDER_STATUS)
  title     String           @db.VarChar(150)
  message   String           @db.Text
  orderId   String?          @map("order_id") @db.Char(36)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================
// MARKETING NOTIFICATIONS (admin-managed broadcasts)
// ============================================================
// Deals/offers/announcements authored by admins. Rendered to
// customers as a time-bounded active list — never fanned out into
// per-user rows. Deletable: no historical/accounting dependency.

model MarketingNotification {
  id        String                    @id @default(uuid()) @db.Char(36)
  title     String                    @db.VarChar(150)
  message   String                    @db.Text
  type      MarketingNotificationType @default(OFFER)
  isActive  Boolean                   @default(true) @map("is_active")
  startsAt  DateTime?                 @map("starts_at")
  expiresAt DateTime?                 @map("expires_at")
  // Controlled internal destination only (never a free URL):
  // SHOP | CATEGORY | PRODUCT | COUPON, with linkValue carrying the
  // entity id / coupon code. Null = no destination.
  linkType  String?                   @map("link_type") @db.VarChar(20)
  linkValue String?                   @map("link_value") @db.VarChar(100)
  createdBy String?                   @map("created_by") @db.Char(36)
  // Tenant association (Phase 2C-7, hardened Phase 2C-10). No
  // derivable company exists, so the column is required: every writer
  // stamps the creator's server-resolved company.
  companyId String                   @map("company_id") @db.Char(36)
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([companyId])
  @@map("marketing_notifications")
}

// ============================================================
// SITE ANNOUNCEMENTS (admin-editable top bar)
// ============================================================
// At most one row is shown at a time: the backend resolves the
// current announcement deterministically (active + in-window,
// highest priority, then newest). No generic CMS.

model SiteAnnouncement {
  id        String    @id @default(uuid()) @db.Char(36)
  message   String    @db.VarChar(200)
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  // Optional internal destination (route path such as "/shop").
  // Never a free external URL.
  linkLabel String?   @map("link_label") @db.VarChar(50)
  linkTarget String?  @map("link_target") @db.VarChar(200)
  priority  Int       @default(0)
  createdBy String?   @map("created_by") @db.Char(36)
  // Tenant association (Phase 2C-7, hardened Phase 2C-10). Same
  // rationale as marketing broadcasts; required, stamped at creation.
  // The public /current read stays global until CompanyDomain runtime
  // resolution (documented limitation).
  companyId String   @map("company_id") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([companyId])
  @@map("site_announcements")
}

// ============================================================
// AUDIT LOG (cross-cutting security/activity record, Phase 2C-14)
// ============================================================
// Append-only from the application's perspective: no update or
// delete paths exist (only retention cleanup and company-deletion
// purge may remove rows in the future). This is NOT an
// authorization source and does NOT replace the domain histories
// (OrderStatusHistory, CouponHistory, inventory ledger), which stay
// intact. Actor identity is snapshotted (role + email) with no hard
// user FK so rows survive user deletion, following the history-table
// convention. companyId null marks platform-level events.

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  actorId     String?  @map("actor_id") @db.Char(36)
  actorRole   String   @map("actor_role") @db.VarChar(50)
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  companyId   String?  @map("company_id") @db.Char(36)
  action      String   @map("action") @db.VarChar(50)
  resource    String   @map("resource") @db.VarChar(100)
  resourceId  String?  @map("resource_id") @db.Char(36)
  outcome     String   @map("outcome") @db.VarChar(20)
  details     Json?    @map("details")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// AUDIT RETENTION POLICY (platform singleton, Phase 2C-19)
// ============================================================
// Exactly one row (id "global") holds the platform-wide audit-log
// retention setting. NEVER is the default (no row means NEVER —
// cleanup deletes nothing). Only SUPER_ADMIN changes it through the
// retention API; per-company retention does not exist. updatedBy is
// the actor id snapshot with no user FK (survives user deletion,
// history-table convention).

model AuditRetentionPolicy {
  id        String   @id @default("global") @db.VarChar(32)
  policy    String   @default("NEVER") @db.VarChar(20)
  updatedBy String?  @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_retention_policy")
}
